# Copiar para .env (local). No Coolify: colar em Environment Variables (Developer view).
# Os 3 segredos são obrigatórios; gere cada um com o comando indicado.

# openssl rand -hex 32  (assina o login; também deriva a chave que cifra a chave do Asaas)
JWT_SECRET=
# openssl rand -hex 24  (cifra e segredos internos do Appwrite — não mude depois de criado)
APPWRITE_SECRET=
# openssl rand -hex 24  (senha do MongoDB)
DB_PASSWORD=

# local ou production. No Coolify: production (ou omitir). O Swagger (/docs) fica ligado nos dois
APP_ENV=production
# cadastro público de novas famílias
ALLOW_REGISTRATION=true
# no Coolify: o domínio do console do Appwrite, sem https:// (ex.: db.seudominio.com)
APPWRITE_DOMAIN=localhost

# preenchidos depois de criar o projeto e a chave de API no console do Appwrite (ver db/README.md)
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
